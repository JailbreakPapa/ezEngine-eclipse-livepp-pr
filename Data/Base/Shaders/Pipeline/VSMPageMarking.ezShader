[PLATFORMS]
ALL

[PERMUTATIONS]
CAMERA_MODE

[COMPUTESHADER]

#include <Shaders/Common/Common.h>
#include <Shaders/Common/GlobalConstants.h>
#include <Shaders/Common/VirtualShadowMapData.h>

Texture2DArray SceneDepth;

// Append buffer for page requests (atomic writes)
RWStructuredBuffer<uint> PageRequestBuffer;

[numthreads(VSM_PAGE_MARKING_THREAD_X, VSM_PAGE_MARKING_THREAD_Y, 1)]
void main(uint3 DTid : SV_DispatchThreadID)
{
  uint2 screenSize = uint2(ViewportSize.xy);
  if (any(DTid.xy >= screenSize))
    return;

  // Read scene depth
  float depthFromZBuffer = SceneDepth.Load(int4(DTid.xy, 0, 0)).r;

  // Skip sky pixels
  if (depthFromZBuffer >= 1.0)
    return;

  float linearDepth = LinearizeZBufferDepth(depthFromZBuffer);

  // Reconstruct world position
  float2 uv = (float2(DTid.xy) + 0.5) / float2(screenSize);
  float2 clipXY = uv * float2(2.0, -2.0) + float2(-1.0, 1.0);
  float4 worldPosH = mul(GetScreenToWorldMatrix(), float4(clipXY, depthFromZBuffer, 1.0));
  float3 worldPosition = worldPosH.xyz / worldPosH.w;

  // Project into the finest clipmap level (level 0) to determine which level to use.
  // ClipmapWorldToUV maps world position to UV space. The sample matrix is origin-centered,
  // so UVs are stable across frames.
  float4 uv0 = mul(ClipmapWorldToUV[0], float4(worldPosition, 1.0));

  // Select clipmap level using NDC magnitude (before the 0.5+0.5 remap in ClipmapWorldToUV).
  // ClipmapWorldToUV already includes the *0.5+0.5 remap, so recover NDC: ndc = (uv - 0.5) / 0.5
  // For X: ndc_x = (uv.x - 0.5) / 0.5.  For Y (flipped): ndc_y = (uv.y - 0.5) / (-0.5).
  // We only need abs(ndc), so: abs(ndc) = abs(uv - 0.5) / 0.5 = abs(uv - 0.5) * 2.
  float2 ndcAbs = abs(uv0.xy - 0.5) * 2.0;
  float maxNDC = max(ndcAbs.x, ndcAbs.y);

  // Each subsequent clipmap level covers 2x the area, so NDC values are halved per level.
  // Level = ceil(log2(max(|ndc|, 1))): find smallest level where |ndc| / 2^level <= 1.
  uint level = (uint)ceil(log2(max(maxNDC, 1.0)));
  if (level >= NumClipmapLevels)
    return;

  // Use the selected level's ClipmapWorldToUV for the actual page coordinate
  float4 clipmapUV4 = mul(ClipmapWorldToUV[level], float4(worldPosition, 1.0));

  // Toroidal wrapping: the sample matrix is origin-centered so UVs can exceed [0,1]
  float2 virtualUV = frac(clipmapUV4.xy);

  // Compute page coordinate
  uint2 pageCoord = uint2(virtualUV * float(VSM_PAGES_PER_LEVEL));
  pageCoord = min(pageCoord, VSM_PAGES_PER_LEVEL - 1);

  // Encode request index and mark this page as requested
  uint requestIndex = level * VSM_PAGES_PER_LEVEL * VSM_PAGES_PER_LEVEL + pageCoord.y * VSM_PAGES_PER_LEVEL + pageCoord.x;
  InterlockedOr(PageRequestBuffer[requestIndex], 1u);
}
