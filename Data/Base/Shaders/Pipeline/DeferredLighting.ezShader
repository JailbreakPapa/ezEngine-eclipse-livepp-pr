[PLATFORMS]
ALL

[PERMUTATIONS]
CAMERA_MODE
SHADING_QUALITY = SHADING_QUALITY_NORMAL
SHADOW_QUALITY

[RENDERSTATE]
DepthTest = false
DepthWrite = false
CullMode = CullMode_None

[VERTEXSHADER]

#include <Shaders/Pipeline/FullscreenTriangleVertexShader.h>

[PIXELSHADER]

#include <Shaders/Pipeline/FullscreenTriangleInterpolator.h>
#include <Shaders/Common/Common.h>
#define USE_MATERIAL_SUBSURFACE_COLOR
#include <Shaders/Common/Lighting.h>
#include <Shaders/Common/GBufferEncoding.h>
#include "DeferredLightingConstants.h"

// GBuffer inputs
Texture2DArray GBuffer0Texture BIND_GROUP(BG_RENDER_PASS); // Albedo + Metallic
Texture2DArray GBuffer1Texture BIND_GROUP(BG_RENDER_PASS); // Normal + Roughness + Flags
Texture2DArray GBuffer2Texture BIND_GROUP(BG_RENDER_PASS); // Emission + AO

// Per-profile SSS defaults for deferred path
// Since GBuffer doesn't store subsurface parameters, we use profile-based defaults
// Note: GBuffer material flags only have 2 bits, so only 3 profiles can be encoded (Skin, Wax, Jade).
// Milk and Foliage profiles work in forward rendering but fall back to Jade in deferred.
struct SSSProfileDefaults
{
  float3 tint;
  float scatterPower;
  float shadowFalloff;
};

static const SSSProfileDefaults g_SSSDefaults[3] =
{
  { float3(1.0, 0.4, 0.25), 9.0, 0.5 },  // Skin: warm reddish tint
  { float3(1.0, 0.9, 0.7), 6.0, 0.7 },   // Wax: warm yellow, high scatter
  { float3(0.5, 0.85, 0.45), 14.0, 0.2 } // Jade/Foliage: green tint, thin translucency
};

float3 ReconstructWorldPosition(float2 uv, float depthFromZBuffer)
{
  float2 clipXY = uv * float2(2.0, -2.0) + float2(-1.0, 1.0);
  float4 worldPosH = mul(GetScreenToWorldMatrix(), float4(clipXY, depthFromZBuffer, 1.0));
  return worldPosH.xyz / worldPosH.w;
}

float4 main(PS_IN Input) : SV_Target
{
#if CAMERA_MODE == CAMERA_MODE_STEREO
  s_ActiveCameraEyeIndex = Input.RenderTargetArrayIndex;
#endif

  float2 uv = Input.TexCoord0.xy;
  float3 uvSlice = float3(uv, s_ActiveCameraEyeIndex);

  // Sample GBuffer
  float4 gb0 = GBuffer0Texture.SampleLevel(PointClampSampler, uvSlice, 0);
  float4 gb1 = GBuffer1Texture.SampleLevel(PointClampSampler, uvSlice, 0);
  float4 gb2 = GBuffer2Texture.SampleLevel(PointClampSampler, uvSlice, 0);

  // Sample depth
  float depthFromZBuffer = SceneDepth.SampleLevel(PointClampSampler, uvSlice, 0).r;
  float linearDepth = LinearizeZBufferDepth(depthFromZBuffer);

  // Decode GBuffer
  GBufferData gbData = DecodeGBuffer(gb0, gb1, gb2);

  // Skip sky pixels (depth = max)
  if (depthFromZBuffer >= 1.0)
  {
    return float4(gbData.emission, 1.0);
  }

  // Reconstruct world position
  float3 worldPosition = ReconstructWorldPosition(uv, depthFromZBuffer);

  // Reconstruct material data for the lighting pipeline
  ezMaterialData matData;
  matData.worldPosition = worldPosition;
  matData.worldNormal = gbData.normal;
  matData.vertexNormal = gbData.normal; // No per-vertex normal in GBuffer, use pixel normal
  matData.diffuseColor = gbData.albedo * (1.0 - gbData.metallic);
  matData.specularColor = lerp(0.04, gbData.albedo, gbData.metallic);
  matData.emissiveColor = gbData.emission;
  matData.refractionColor = float4(0, 0, 0, 0);
  matData.roughness = gbData.roughness * gbData.roughness; // perceptual → linear
  matData.perceptualRoughness = gbData.roughness;
  matData.occlusion = gbData.occlusion;
  matData.opacity = 1.0;
  matData.tangentDirection = float3(0, 0, 1);

  // Initialize SSS based on material flags from GBuffer
  matData.subsurfaceColor = float3(0, 0, 0);
  matData.subsurfaceScatterPower = 0;
  matData.subsurfaceShadowFalloff = 0;
  matData.subsurfaceProfileIndex = 0;

  // Enable SSS for flagged pixels (materialFlags: 0=none, 1-3=SSS profiles)
  if (gbData.materialFlags != GBUFFER_MATFLAG_DEFAULT)
  {
    uint profileIdx = gbData.materialFlags - 1;
    SSSProfileDefaults profile = g_SSSDefaults[profileIdx];
    matData.subsurfaceProfileIndex = profileIdx;
    matData.subsurfaceColor = matData.diffuseColor * profile.tint;
    matData.subsurfaceScatterPower = profile.scatterPower;
    matData.subsurfaceShadowFalloff = profile.shadowFalloff;
  }

  // Screen position for cluster lookup: xy = pixel coords, z = linear depth
  float3 screenPosition = float3(Input.Position.xy, linearDepth);

  // Get cluster data for this pixel
  ezPerClusterData clusterData = GetClusterData(screenPosition);

  // Calculate lighting using the same pipeline as forward rendering
  AccumulatedLight light = CalculateLighting(matData, clusterData, screenPosition, true);

  // Final compositing
  float3 litColor = light.diffuseLight + light.specularLight;
  litColor += matData.emissiveColor;

  // Apply fog
  litColor = ApplyFog(litColor, worldPosition);

  return float4(litColor, 1.0);
}
